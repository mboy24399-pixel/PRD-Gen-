# PRD Forge Vercel server-side provider pools
# NEVER prefix secrets with NEXT_PUBLIC_ and never commit real values.
GEMINI_API_KEY=
GEMINI_API_KEYS=
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENAI_API_KEY=
OPENAI_API_KEYS=
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEYS=
GROQ_API_KEY=
GROQ_API_KEYS=
MISTRAL_API_KEY=
MISTRAL_API_KEYS=
CUSTOM_API_KEY=
CUSTOM_API_KEYS=

# Security controls
# Comma-separated browser origins allowed to use server-managed keys.
PRD_FORGE_ALLOWED_ORIGINS=http://localhost:3000
# Custom provider domains must be explicitly allow-listed.
PRD_FORGE_CUSTOM_DOMAINS=

NEXT_PUBLIC_APP_URL=http://localhost:3000
